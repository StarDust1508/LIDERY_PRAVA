# ─────────────────────────────────────────────────────────────────────────────
# Переменные окружения платформы «Лидеры права» (lideryprava.ru).
#
# Скопируйте файл в platform/.env (или platform/server/.env) и заполните значения.
# Секреты НЕ коммитятся: реальный .env должен быть в .gitignore.
#
# При старте обязательны (процесс упадёт с понятной ошибкой, если их нет):
#   DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD,
#   JWT_SECRET, ADMIN_SESSION_SECRET, ADMIN_PASSWORD.
# ─────────────────────────────────────────────────────────────────────────────

# Режим работы: development | production | test
NODE_ENV=development

# ── HTTP-сервер ──────────────────────────────────────────────────────────────
# Приложение намеренно слушает loopback: публичный вход только через nginx/HTTPS.
API_HOST=127.0.0.1
API_PORT=3001

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=liders
DATABASE_USER=liders
DATABASE_PASSWORD=change-me-in-env
# Единственная схема проекта. Все таблицы создаются в ней.
DATABASE_SCHEMA=liders

# ── Секреты (обязательны, минимум 32 символа каждый) ─────────────────────────
# Подпись краткосрочных ссылок на приватные материалы.
JWT_SECRET=replace-with-random-32-plus-characters-string
JWT_EXPIRES_IN=7d
# Ключ подписи HMAC-токенов админ-сессии (не совпадает с паролем).
ADMIN_SESSION_SECRET=replace-with-another-random-32-plus-characters
# Время жизни админ-сессии, часы (1..24).
ADMIN_SESSION_TTL_HOURS=12

# ── Вход в админку ───────────────────────────────────────────────────────────
# Основной режим: общий логин и пароль из окружения.
ADMIN_LOGIN=admin
# Минимум 8 символов. Пароль и ключ подписи сессий — разные секреты.
ADMIN_PASSWORD=replace-with-your-own-strong-password

# ── Файлы ────────────────────────────────────────────────────────────────────
# Максимальный размер загружаемого файла, байт (по умолчанию 25 МиБ).
# 25 МиБ: тексты законопроектов со сканами и приложениями.
MAX_FILE_SIZE=26214400
# Время кэширования публичных файлов (положение, логотипы), секунды.
MEDIA_PUBLIC_CACHE_SECONDS=31536000

# ── Публичный адрес и CORS ───────────────────────────────────────────────────
PUBLIC_BASE_URL=https://lideryprava.ru
# Список origin через запятую. Только эти источники допускаются к API с cookie.
CORS_ORIGINS=https://lideryprava.ru,https://www.lideryprava.ru

# ── Content-Security-Policy ──────────────────────────────────────────────────
# enforce | report | off
CSP_MODE=enforce
# Дополнительные доверенные origin (аналитика, шрифты) через запятую.
CSP_EXTRA_ORIGINS=
