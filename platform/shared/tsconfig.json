{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Типы Node нужны тестам (node:test, node:assert), которые лежат рядом с
    // исходниками и проверяются тем же tsc.
    "types": ["node"]
  },
  "include": ["src"]
}
