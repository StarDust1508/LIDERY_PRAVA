# Шаблон файла окружения API платформы «Лидеры права».
#
# Установка на сервере:
#   install -d -m 750 -o root -g liders /etc/lideryprava
#   install -m 640 -o root -g liders ops/api.env.example /etc/lideryprava/api.env
#   # заполнить секреты (см. команды ниже), затем:
#   systemctl restart liders-api
#
# Права: 640, владелец root, группа liders — сервис читает файл, но не пишет.
# Секреты НЕ коммитятся: реальный /etc/lideryprava/api.env в репозиторий не попадает.
#
# Генерация секретов (выполнить на сервере, значения вставить ниже):
#   openssl rand -base64 48      # JWT_SECRET
#   openssl rand -base64 48      # ADMIN_SESSION_SECRET
#   openssl rand -base64 24      # ADMIN_PASSWORD (не короче 8 символов)
#   openssl rand -base64 24      # DATABASE_PASSWORD (для пользователя liders)
#
# Пароль администратора и ключи подписи — РАЗНЫЕ секреты. Пароль из
# ADMIN_PASSWORD предназначен для первичного входа; постоянных пользователей
# заводят в админке (роли admin и operator).

# ── Режим ────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=8100

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=liders
DATABASE_USER=liders
DATABASE_PASSWORD=ЗАМЕНИТЕ_СЕКРЕТОМ
# Единственная схема проекта: все таблицы создаются в ней.
DATABASE_SCHEMA=liders

# ── Секреты приложения (каждый не короче 32 символов) ────────────────────────
JWT_SECRET=ЗАМЕНИТЕ_СЕКРЕТОМ_НЕ_КОРОЧЕ_32_СИМВОЛОВ
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=ЗАМЕНИТЕ_ДРУГИМ_СЕКРЕТОМ_НЕ_КОРОЧЕ_32
# Срок сеанса — 12 часов (ТЗ 07, п. 1.2), выход при бездействии — 60 минут.
ADMIN_SESSION_TTL_HOURS=12
ADMIN_IDLE_MINUTES=60

# ── Первичный вход в админку ─────────────────────────────────────────────────
# Пароль из окружения — резервный доступ владельца платформы: он даёт роль
# администратора и не привязан к учётной записи. Постоянных сотрудников заводят
# в разделе «Пользователи» (роли admin и operator) и после этого общий пароль
# меняют или отключают (ТЗ 11, п. 45: общий пароль на нескольких людей — риск).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ЗАМЕНИТЕ_СЕКРЕТОМ

# ── Файлы ────────────────────────────────────────────────────────────────────
# 25 МиБ: тексты законопроектов с приложениями.
MAX_FILE_SIZE=26214400
MEDIA_PUBLIC_CACHE_SECONDS=31536000

# ── Публичный адрес, CORS, CSP ───────────────────────────────────────────────
PUBLIC_BASE_URL=https://lideryprava.ru
CORS_ORIGINS=https://lideryprava.ru,https://www.lideryprava.ru
CSP_MODE=enforce
CSP_EXTRA_ORIGINS=
